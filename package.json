{
  "name": "internal-laneway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "VITE_NOTIFICATIONS=poll npm run build && node server/migrate.ts migrate && node server/migrate.ts seed-if-empty && node scripts/build-vercel.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts migrate",
    "db:seed": "node --env-file-if-exists=.env server/migrate.ts seed",
    "db:reset": "node --env-file-if-exists=.env server/migrate.ts reset",
    "test:rls": "node --env-file-if-exists=.env scripts/rls-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/saira-extra-condensed": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
