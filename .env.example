# Postgres connection string. Locally this matches docker-compose.yml.
# On Neon, use the direct (non-pooled) connection string with ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/laneway

# Signs session cookies. Required in production: use a long random string,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me

# Port for the API server (the hosting platform usually sets this).
PORT=8787

# Load the demo data on startup when the database has no users yet.
SEED_IF_EMPTY=true

# Email invites over SMTP (Gmail by default: the address and a Google App password).
# Leave unset in development to print invite emails in the console instead.
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM="Laneway Education <you@gmail.com>"
# APP_URL=https://your-project.vercel.app
